{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/Set/Your/Image_Path", 
        "width": 32,
        "height": 20,
        "padding": { "top": 2, "left": 2 }
    },
    "display": {
        "separator": " ⟫ ",
        "color": {
            "keys": "38;5;137", 
            "title": "38;5;144" 
        }
    },
    "modules": [
        {

            "type": "custom",
            "format": " \u001b[38;5;144mUNIT ID: AIGIS-024 \u001b[90m// \u001b[38;5;137mSTATUS: OPERATIONAL"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;144m▛▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀ SYSTEM DIAGNOSTICS ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▜\u001b[0m"
        },
        {
            "type": "os",
            "key": " █ OS     ",
            "keyColor": "38;5;144"
        },
        {
            "type": "kernel",
            "key": " █ KERNEL ",
            "keyColor": "38;5;144"
        },
        {
            "type": "shell",
            "key": " █ SHELL  ",
            "keyColor": "38;5;144"
        },
        {
            "type": "uptime",
            "key": " █ ACTIVE ",
            "keyColor": "38;5;144"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;137m▌        \u001b[38;5;144mHARDWARE ENGAGEMENT\u001b[0m"
        },
        {
            "type": "cpu",
            "key": " █ PROC   ",
            "keyColor": "38;5;137"
        },
        {
            "type": "gpu",
            "key": " █ CORE   ",
            "keyColor": "38;5;137"
        },
        {
            "type": "memory",
            "key": " █ MEM    ",
            "keyColor": "38;5;137"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;144m▙▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▟\u001b[0m"
        },
        "break",
        {
            "type": "custom",
            "format": " \u001b[38;2;117;142;133mSYSTEM REV: 1.0.24  \u001b[38;2;176;141;87m[■■■■■■■■■■■■□□□]"
        }
    ]
}
