[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1

[input]
# Change to 'pipewire' if 'pulse' doesn't respond
method = pulse
source = auto

[output]
# 'ncurses' is best for Ghostty
method = ncurses

[color]
gradient = 1
gradient_count = 3
gradient_color_1 = '#566962'
gradient_color_2 = '#94aca2'
gradient_color_3 = '#e3d9a4'
gradient_color_4 = '#ffffff'

[smoothing]
monstercat = 1
waves = 0
